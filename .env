# Copie este arquivo para ".env" (ambiente local) e/ou configure estas duas
# variáveis nas configurações do projeto na Vercel ("Environment Variables").
# Os dois valores ficam em: Supabase -> seu projeto -> Project Settings -> API

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
